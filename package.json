{
  "name": "butler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "sudo systemctl start butler",
    "stop": "sudo systemctl stop butler",
    "restart": "sudo systemctl restart butler",
    "status": "systemctl status butler --no-pager",
    "deploy": "node scripts/butler-deploy.mjs",
    "test": "npm run typecheck",
    "discord": "node dist/main.js",
    "discord:register": "node dist/main.js register-discord-commands",
    "discord:deploy": "npm run build && npm run discord:register",
    "typecheck": "tsc --noEmit",
    "prompt:dump": "node scripts/prompt-dump.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "14.27.0",
    "quickjs-emscripten": "0.32.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
