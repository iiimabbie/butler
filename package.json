{
  "name": "butler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "sh scripts/butler-service.sh start",
    "stop": "sh scripts/butler-service.sh stop",
    "restart": "sh scripts/butler-service.sh restart",
    "status": "sh scripts/butler-service.sh status",
    "deploy": "node scripts/butler-deploy.mjs",
    "test": "npm run typecheck",
    "discord": "node dist/main.js",
    "discord:managed": "sh scripts/discord-restart.sh",
    "discord:register": "node dist/main.js register-discord-commands",
    "discord:deploy": "npm run build && npm run discord:register",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "discord.js": "14.27.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24.17.0"
  }
}
