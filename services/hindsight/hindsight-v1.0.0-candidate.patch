+    def test_patched_worker_permanent_and_cancelled_paths_do_not_long_retry(self):
+        from hindsight_api.engine import memory_engine as engine_module
+        from hindsight_api.worker.exceptions import RetryTaskAt
+        from hindsight_api.worker.poller import ClaimedTask
+
+        class Conn:
+            def __init__(self, status): self.status = status
+            async def fetchrow(self, *args): return {"status": self.status}
+        async def one_run(status, error, nonretryable):
+            @asynccontextmanager
+            async def acquire(_backend): yield Conn(status)
+            @asynccontextmanager
+            async def audit(*args, **kwargs): yield SimpleNamespace(response=None)
+            engine = object.__new__(engine_module.MemoryEngine)
+            engine._audit_logger = MagicMock()
+            op_id = "33333333-3333-4333-8333-333333333333"
+            payload = {"type": "batch_retain", "operation_id": op_id, "bank_id": "synthetic-bank", "_retry_count": 99, "contents": []}
+            engine._handle_batch_retain = AsyncMock(side_effect=error)
+            engine._get_backend = AsyncMock(return_value=object())
+            engine._mark_operation_failed = AsyncMock()
+            with (patch.object(engine_module, "acquire_with_retry", new=acquire),
+                  patch.object(engine_module, "audit_context", new=audit),
+                  patch.object(engine_module, "set_stage", return_value=None),
+                  patch.object(engine_module, "fq_table", side_effect=lambda table: table),
+                  patch.object(engine_module, "get_config", return_value=SimpleNamespace(worker_max_retries=3, worker_task_retry_backoff_seconds=60)),
+                  patch.object(engine_module, "_is_non_retryable_task_error", return_value=nonretryable)):
+                if status == "cancelled":
+                    await engine._execute_task(payload)
+                    engine._handle_batch_retain.assert_not_awaited()
+                    return
+                if nonretryable:
+                    await engine._execute_task(payload)
+                    engine._mark_operation_failed.assert_awaited_once()
+                    return
+                with unittest.TestCase().assertRaises(Exception) as caught:
+                    await engine._execute_task(payload)
+                assert not isinstance(caught.exception, RetryTaskAt)
+                engine._mark_operation_failed.assert_not_awaited()
+        asyncio.run(one_run("processing", StatusError(401), True))
+        asyncio.run(one_run("cancelled", StatusError(503), False))
