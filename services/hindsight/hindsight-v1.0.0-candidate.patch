+"""Runtime smoke/unit checks for the v1.0.0 Butler patch set (no network calls)."""
+import asyncio
+import io
+import tempfile
+import unittest
+import wave
+import zipfile
+from contextlib import asynccontextmanager
+from datetime import datetime, timezone
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+from PIL import Image
+import fitz
+
+from hindsight_api.api.http import (RecallRequest, ReflectRequest, RetainRequest, CreatePageRequest, UpdateNodeRequest, KnowledgeNode, KnowledgePageResponse, AsyncOperationSubmitResponse)
+from hindsight_api.engine.memory_engine import Budget, _resolve_reranker_max_candidates
+from hindsight_api.engine.cross_encoder import TypeSafeCrossEncoder
+from hindsight_api.engine.task_recovery import is_transient_task_error, recovery_delay_seconds
+
+
+class Config:
+    reranker_max_candidates = 300
+    reranker_max_candidates_low = 30
+    reranker_max_candidates_mid = 500
+    reranker_max_candidates_high = 0
+
+
+class StatusError(Exception):
+    def __init__(self, status_code):
+        self.status_code = status_code
+
+
+class PatchTests(unittest.TestCase):
+    def test_request_defaults_and_explicit_overrides(self):
+        recall = RecallRequest(query="test")
+        self.assertEqual((recall.budget.value, recall.max_tokens), ("mid", 1200))
+        recall_explicit = RecallRequest(query="test", budget="high", max_tokens=777)
+        self.assertEqual((recall_explicit.budget.value, recall_explicit.max_tokens), ("high", 777))
+        reflect = ReflectRequest(query="test")
+        self.assertEqual((reflect.budget.value, reflect.max_tokens), ("mid", 1600))
+        reflect_explicit = ReflectRequest(query="test", budget="low", max_tokens=888)
+        self.assertEqual((reflect_explicit.budget.value, reflect_explicit.max_tokens), ("low", 888))
+
+    def test_request_schema_contracts_without_network_or_write(self):
+        retain = RetainRequest.model_validate({"items": [{"content": "synthetic contract", "document_id": "upgrade-test"}], "async": True, "operation_id": "11111111-1111-4111-8111-111111111111"})
+        self.assertTrue(retain.async_)
+        self.assertEqual(retain.operation_id, "11111111-1111-4111-8111-111111111111")
+        page = CreatePageRequest.model_validate({"name": "Synthetic isolated page", "source_query": "synthetic query", "tags": [], "trigger": {}})
+        self.assertEqual(page.name, "Synthetic isolated page")
+        patch = UpdateNodeRequest.model_validate({"name": "Synthetic rename"})
+        self.assertEqual(patch.name, "Synthetic rename")
+
+    def test_knowledge_read_update_refresh_response_contracts(self):
+        page_node = KnowledgeNode.model_validate({"id":"synthetic-page","kind":"page","name":"Synthetic page","mental_model_id":"synthetic-model","description":"Synthetic query","children":[]})
+        self.assertEqual(page_node.mental_model_id, "synthetic-model")
+        page = KnowledgePageResponse.model_validate({"id":"synthetic-page","name":"Synthetic page","type":"knowledge-page","description":"Synthetic query","body":"Synthetic body","markdown":"---\\nname: Synthetic page\\n---\\nSynthetic body"})
+        self.assertEqual(page.id, "synthetic-page")
+        queued = AsyncOperationSubmitResponse.model_validate({"operation_id":"11111111-1111-4111-8111-111111111111","status":"queued"})
+        self.assertEqual(queued.status, "queued")
+
+    def test_reranker_budget_and_hard_cap(self):
+        config = Config()
+        self.assertEqual(_resolve_reranker_max_candidates(config, Budget.LOW), 30)
+        self.assertEqual(_resolve_reranker_max_candidates(config, Budget.MID), 50)
+        self.assertEqual(_resolve_reranker_max_candidates(config, Budget.HIGH), 50)
+        config.reranker_max_candidates_low = 0
+        self.assertEqual(_resolve_reranker_max_candidates(config, Budget.LOW), 50)
+        config.reranker_max_candidates = 0
+        self.assertEqual(_resolve_reranker_max_candidates(config, Budget.LOW), 0)
+
+    def test_cross_encoder_limit(self):
+        self.assertEqual(TypeSafeCrossEncoder.MAX_QUESTION_TOKENS, 20_000)
+
+    def test_transient_permanent_and_chunk_classification(self):
+        self.assertTrue(is_transient_task_error(StatusError(503)))
+        self.assertFalse(is_transient_task_error(StatusError(401)))
+        self.assertFalse(is_transient_task_error(RuntimeError("unknown parsing error")))
+        self.assertFalse(is_transient_task_error(asyncio.CancelledError()))
+        mixed = RuntimeError("mixed chunks")
+        mixed._task_chunk_errors = (StatusError(503), RuntimeError("permanent/unknown"))
+        self.assertFalse(is_transient_task_error(mixed))
+        all_transient = RuntimeError("all transient chunks")
+        all_transient._task_chunk_errors = (StatusError(503), StatusError(429))
+        self.assertTrue(is_transient_task_error(all_transient))
+
+    def test_long_retry_schedule(self):
+        self.assertEqual([recovery_delay_seconds(n, 3) for n in (3, 4, 5, 6, 99)], [300, 900, 1800, 1800, 1800])
+
+    def test_butler_parser_basic_text_without_external_calls(self):
+        from hindsight_api.engine.parsers.butler import ButlerParser
+        result = asyncio.run(ButlerParser().convert(b"synthetic parser smoke", "smoke.txt"))
+        self.assertIn("synthetic parser smoke", result)
+
+    def test_zip_and_pdf_parsing_locally(self):
+        from hindsight_api.engine.parsers.butler import ButlerParser
+        buffer = io.BytesIO()
+        with zipfile.ZipFile(buffer, "w") as archive:
+            archive.writestr("note.txt", "synthetic zip text")
+        zip_result = asyncio.run(ButlerParser().convert(buffer.getvalue(), "note.zip"))
+        self.assertIn("synthetic zip text", zip_result)
+        pdf = fitz.open()
+        page = pdf.new_page()
+        page.insert_text((72, 72), "synthetic PDF text")
+        pdf_bytes = pdf.tobytes()
+        pdf.close()
+        pdf_result = asyncio.run(ButlerParser().convert(pdf_bytes, "note.pdf"))
+        self.assertIn("synthetic PDF text", pdf_result)
+
+    def test_image_and_video_local_path_with_vision_stub(self):
+        from hindsight_api.engine.parsers.butler import ButlerParser
+        parser = ButlerParser()
+        parser._vision = AsyncMock(return_value="synthetic image description")
+        image = Image.new("RGB", (48, 32), color=(10, 20, 30))
+        buf = io.BytesIO()
+        image.save(buf, format="PNG")
+        image_result = asyncio.run(parser.convert(buf.getvalue(), "synthetic.png"))
+        self.assertIn("synthetic image description", image_result)
+        parser._image = AsyncMock(return_value="# Image: frame.jpg\n\nsynthetic frame")
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "synthetic.mp4"
+            import subprocess
+            subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-f", "lavfi", "-i", "color=c=blue:s=320x180:d=2", "-an", "-y", str(path)], check=True, timeout=30)
+            video_result = asyncio.run(parser.convert(path.read_bytes(), path.name))
+        self.assertIn("synthetic frame", video_result)
+
