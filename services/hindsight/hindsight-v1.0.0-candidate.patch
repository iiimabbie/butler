+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { Hindsight } from '../dist/hindsight.js';
+
+const basePage = {
+  id: 'fixture-page',
+  name: 'Fixture page',
+  type: 'knowledge-page',
+  tags: [],
+  timestamp: null,
+  body: null,
+  markdown: '---\nname: Fixture page\n---\nNo content yet.',
+};
+
+function clientReturning(page) {
+  return new Hindsight(
+    { baseUrl: 'http://fixture.invalid', bankId: 'fixture-bank' },
+    async () => new Response(JSON.stringify(page), {
+      status: 200,
+      headers: { 'content-type': 'application/json' },
+    }),
+  );
+}
+
+test('knowledge page read preserves a string description', async () => {
+  const page = await clientReturning({ ...basePage, description: 'fixture source query' }).getKnowledgePage('fixture-page');
+  assert.equal(page.description, 'fixture source query');
+});
+
+test('knowledge page read normalizes only explicit null description to the existing string contract', async () => {
+  const page = await clientReturning({ ...basePage, description: null }).getKnowledgePage('fixture-page');
+  assert.equal(page.description, '');
+  assert.equal(typeof page.description, 'string');
+});
+
+test('knowledge page read still rejects missing or non-string/non-null descriptions', async () => {
+  const { description: _omit, ...missing } = basePage;
+  await assert.rejects(clientReturning(missing).getKnowledgePage('fixture-page'), /response is invalid/);
+  await assert.rejects(clientReturning({ ...basePage, description: 17 }).getKnowledgePage('fixture-page'), /response is invalid/);
+  await assert.rejects(clientReturning({ ...basePage, description: {} }).getKnowledgePage('fixture-page'), /response is invalid/);
+});
