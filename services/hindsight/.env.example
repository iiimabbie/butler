# Copy to .env and fill from the explicitly authorized local service configs.
HINDSIGHT_API_HOST=0.0.0.0
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LLM_PROVIDER=openai-responses
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:8317/v1
HINDSIGHT_API_LLM_API_KEY=replace-with-authorized-Butler-CPA-key
HINDSIGHT_API_LLM_MODEL=replace-with-authorized-Butler-CPA-model
HINDSIGHT_API_EMBEDDINGS_PROVIDER=litellm-sdk
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_API_BASE=https://api.voyageai.com/v1
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_API_KEY=replace-with-authorized-UMIRO-embedding-key
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_MODEL=voyage/voyage-4
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_OUTPUT_DIMENSIONS=1024
HINDSIGHT_API_EMBEDDINGS_LITELLM_SDK_ENCODING_FORMAT=
HINDSIGHT_API_RERANKER_PROVIDER=local
HINDSIGHT_API_RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
